    },
    {
      "id": "adv3",
      "type": "text",
      "x": 20,
      "y": 2940,
      "width": 323.40000000000003,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3080,
      "version": 1,
      "versionNonce": 3200,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "EV = p x reward - (1 - p) x lifeCost\nlifeCost = 240 / lives  (lives is at least 1)\n\np         success chance, from the probability\n          label (CORE-04)\nreward    gold the ad pays on success\nlifeCost  gold value of the life lost on failure:\n          1 life = 240, 2 = 120, 3 = 80\n\nShown rounded, with a sign. Negative is red.\nEach ad is scored on its own; the board is\nnot touched.",
      "originalText": "EV = p x reward - (1 - p) x lifeCost\nlifeCost = 240 / lives  (lives is at least 1)\n\np         success chance, from the probability\n          label (CORE-04)\nreward    gold the ad pays on success\nlifeCost  gold value of the life lost on failure:\n          1 life = 240, 2 = 120, 3 = 80\n\nShown rounded, with a sign. Negative is red.\nEach ad is scored on its own; the board is\nnot touched.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "adv4",
      "type": "text",
      "x": 440,
      "y": 2940,
      "width": 316.8,
      "height": 195,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 6020,
      "version": 1,
      "versionNonce": 8660,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Label -> p  (starting values, BOT-22 calibrates)\nPiece of cake        0.95\nWalk in the park     0.90\nSure thing           0.85\nQuite likely         0.75\nHmmm....             0.60\nGamble               0.50\nRisky                0.40\nRather detrimental   0.30\nPlaying with fire    0.25\nSuicide mission      0.15\nImpossible           0.05\nUnknown label        0.10",
      "originalText": "Label -> p  (starting values, BOT-22 calibrates)\nPiece of cake        0.95\nWalk in the park     0.90\nSure thing           0.85\nQuite likely         0.75\nHmmm....             0.60\nGamble               0.50\nRisky                0.40\nRather detrimental   0.30\nPlaying with fire    0.25\nSuicide mission      0.15\nImpossible           0.05\nUnknown label        0.10",
      "fontSize": 12,
