# Bot service settings (BOT-16). All optional; these are the defaults.
PORT=3000
HOST=0.0.0.0
GAME_API_URL=https://dragonsofmugloar.com/api/v2
# expected-value | safest-first | steal-budget
DEFAULT_STRATEGY=expected-value
# Safety limit on turns per game (BOT-07), 1 to 5000.
MAX_TURNS=500
# Runs playing at the same time; more are refused with 429 (BOT-15).
MAX_ACTIVE_RUNS=5
# Benchmark games in flight at once, to be gentle with the public API (BOT-24).
BENCH_MAX_CONCURRENCY=4
BENCH_MAX_GAMES=200
# Ended runs stay readable this long (BOT-17), in milliseconds.
RUN_TTL_MS=1800000
LOG_LEVEL=info
# Comma-separated origins, or * for any.
CORS_ORIGIN=*
